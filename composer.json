{
    "name": "kernelk14/aura",
    "description": "AuraPHP - Lightweight PHP MVC Framework with OwnStrap CSS",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "AuraPHP Framework",
            "homepage": "https://github.com/kernelk14/aura"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "Installer\\": "system/installer-needs",
            "AuraCore\\": "system/core/",
            "SiteControllers\\": "site/controllers/"
        },
        "files": [
            "system/helpers/url_helper.php"
        ]
    },
    "bin": [
        "aura"
    ],
    "scripts": {
        "post-root-package-install": [
            "php system/installer-needs/pre-install-display.php"
        ],
        "post-create-project-cmd": [
            "Installer\\PostInstall::run"
        ],
        "serve": "php aura serve",
        "route:list": "php aura route:list"
    },
    "extra": {
        "framework": {
            "name": "AuraPHP",
            "version": "1.0.3"
        }
    }
}
