function cmd_migrate_fresh() {
    if (!confirm(' WARNING: This will drop ALL tables and re-run all migrations. Continue?')) {
        info('Cancelled.');
        return;
    }

    $db = db_bootstrap();
    $pdo = $db->getPdo();
    $driver = $db->getDriver();

    try {
        $pdo->beginTransaction();
        $tables = list_tables($pdo, $driver);

