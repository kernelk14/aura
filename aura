function write($text, $color = null) {
    $colors = [
        'green'   => "\033[32m",
        'red'     => "\033[31m",
        'yellow'  => "\033[33m",
        'blue'    => "\033[34m",
        'cyan'    => "\033[36m",
        'magenta' => "\033[35m",
        'gray'    => "\033[90m",
        'reset'   => "\033[0m",
        'bold'    => "\033[1m",
    ];
    $c = $colors[$color] ?? $colors['reset'];
    $r = $colors['reset'];
    echo $c . $text . $r;
}

function writeln($text = '', $color = null) {
    write($text . "\n", $color);
}

function success($text) { writeln($text, 'green'); }
function error($text) { writeln($text, 'red'); }
function info($text) { writeln($text, 'cyan'); }
function warn($text) { writeln($text, 'yellow'); }

function done() { write('  DONE', 'green'); writeln(); }

function confirm($question) {
    write($question . ' (yes/no) ', 'yellow');
    $handle = fopen('php://stdin', 'r');
    $answer = strtolower(trim(fgets($handle)));
    fclose($handle);
    return $answer === 'yes' || $answer === 'y';
}

function studlyCase($name) {
    return str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $name)));
}

function camelCase($name) {
    return lcfirst(studlyCase($name));
}

function kebabCase($name) {
    return str_replace('_', '-', strtolower(preg_replace('/([a-z])([A-Z])/', '$1-$2', $name)));
}

function pluralize($name) {
    $last = strtolower(substr($name, -1));
    if (in_array($last, ['s', 'x', 'z']) || in_array(strtolower(substr($name, -2)), ['sh', 'ch'])) {
        return $name . 'es';
    }
    if ($last === 'y' && !in_array(strtolower(substr($name, -2, 1)), ['a', 'e', 'i', 'o', 'u'])) {
        return substr($name, 0, -1) . 'ies';
    }
    return $name . 's';
}

function db_bootstrap() {
    require_once AURA_SYSTEM . '/core/base.php';
    require_once AURA_SYSTEM . '/core/database.php';
    require_once AURA_SYSTEM . '/core/query-builder.php';
    require_once AURA_SYSTEM . '/core/schema.php';
    require_once AURA_SYSTEM . '/core/migration.php';
    return new AuraCore\Database();
}

function migration_class($filename) {
    $name = preg_replace('/^\d{4}_\d{2}_\d{2}_\d{6}_/', '', $filename);
    $name = preg_replace('/\.php$/', '', $name);
    $class = 'Migration_' . studlyCase($name);
    return str_replace('-', '_', $class);
}

function db_driver() {
    static $driver = null;
    if ($driver === null) {
        try {
            $db = db_bootstrap();
            $driver = $db->getDriver();
        } catch (\Exception $e) {
            $driver = 'mysql';
        }
    }
    return $driver;
}

function db_quoted($name) {
    $driver = db_driver();
    if ($driver === 'sqlsrv' || $driver === 'mssql') {
        return '[' . str_replace(']', ']]', $name) . ']';
    }
    return '"' . str_replace('"', '""', $name) . '"';
}

function ensure_migrations_table($pdo, $driver) {
    $table = db_quoted('migrations');
    if ($driver === 'sqlite') {
        $pdo->exec("CREATE TABLE IF NOT EXISTS {$table} (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            migration VARCHAR(255) NOT NULL,
            batch INTEGER NOT NULL,
            executed_at TEXT DEFAULT CURRENT_TIMESTAMP
        )");
    } elseif ($driver === 'pgsql') {
        $pdo->exec("CREATE TABLE IF NOT EXISTS {$table} (
            id SERIAL PRIMARY KEY,
            migration VARCHAR(255) NOT NULL,
            batch INTEGER NOT NULL,
            executed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )");
    } elseif ($driver === 'sqlsrv' || $driver === 'mssql') {
        $pdo->exec("IF NOT EXISTS (SELECT * FROM sysobjects WHERE name='migrations' AND xtype='U')
            CREATE TABLE migrations (
                id INT IDENTITY(1,1) PRIMARY KEY,
                migration VARCHAR(255) NOT NULL,
                batch INT NOT NULL,
                executed_at DATETIME DEFAULT GETDATE()
            )");
    } else {
        $pdo->exec("CREATE TABLE IF NOT EXISTS {$table} (
            `id` INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
            `migration` VARCHAR(255) NOT NULL,
            `batch` INT UNSIGNED NOT NULL,
            `executed_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )");
    }
}

function list_tables($pdo, $driver) {
    if ($driver === 'sqlite') {
        $stmt = $pdo->query("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'");
    } elseif ($driver === 'pgsql') {
        $stmt = $pdo->query("SELECT tablename FROM pg_tables WHERE schemaname = 'public'");
    } elseif ($driver === 'sqlsrv' || $driver === 'mssql') {
        $stmt = $pdo->query("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_TYPE = 'BASE TABLE'");
    } else {
        $stmt = $pdo->query("SHOW TABLES");
    }
    return $stmt->fetchAll(\PDO::FETCH_COLUMN);
}

function fetch_max_batch($pdo) {
    $stmt = $pdo->query("SELECT COALESCE(MAX(batch), 0) FROM migrations");
    return (int) $stmt->fetchColumn();
}

function fetch_migration_rows($pdo) {
    $stmt = $pdo->query("SELECT migration, batch, executed_at FROM migrations");
    return $stmt->fetchAll(\PDO::FETCH_ASSOC);
}

function drop_table_safe($pdo, $driver, $table) {
    $wrapped = db_quoted($table);
    if ($driver === 'pgsql') {
        $pdo->exec("DROP TABLE IF EXISTS {$wrapped} CASCADE");
    } else {
        $pdo->exec("DROP TABLE IF EXISTS {$wrapped}");
    }
}

function ensure_dir($dir) {
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }
}

