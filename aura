function cmd_migrate_reset() {
    if (!confirm(' WARNING: This will rollback ALL migrations. Continue?')) {
        info('Cancelled.');
        return;
    }

    $dir = AURA_SITE . '/migrations';
    if (!is_dir($dir)) {
        error('No migrations directory found.');
        return 1;
    }

    $db = db_bootstrap();
    $pdo = $db->getPdo();

    try {
        $pdo->query("SELECT 1 FROM migrations LIMIT 1");
    } catch (\Exception $e) {
        info('Nothing to rollback.');
        return;
    }

    $maxBatch = fetch_max_batch($pdo);

    if ($maxBatch === 0) {
        info('Nothing to rollback.');
        return;
    }

    for ($batch = $maxBatch; $batch >= 1; $batch--) {
        $stmt = $pdo->prepare("SELECT migration FROM migrations WHERE batch = ? ORDER BY id DESC");
        $stmt->execute([$batch]);
        $toRollback = $stmt->fetchAll(\PDO::FETCH_COLUMN);

        foreach ($toRollback as $filename) {
            $file = "{$dir}/{$filename}";
            if (!file_exists($file)) {
                warn("Migration file not found: {$filename}");
                continue;
            }

            require_once $file;
            $class = migration_class($filename);

            if (!class_exists($class)) {
                warn("Could not find class for migration: {$filename}");
                continue;
            }

            write("  {$filename} ... ", 'gray');
            $inTransaction = false;
            try {
                if (!$pdo->inTransaction()) {
                    $pdo->beginTransaction();
                    $inTransaction = true;
                }

                $migration = new $class();
                if (method_exists($migration, 'setDb')) {
                    $migration->setDb($db);
                }
                $migration->down();
                $stmt = $pdo->prepare("DELETE FROM migrations WHERE migration = ? AND batch = ?");
                $stmt->execute([$filename, $batch]);

                if ($inTransaction) {
                    $pdo->commit();
                }
                done();
            } catch (\Exception $e) {
                if ($inTransaction && $pdo->inTransaction()) {
                    $pdo->rollBack();
                }
                error('  FAILED');
                error("  {$e->getMessage()}");
                return 1;
            }
        }
    }

    writeln();
    success('All migrations have been rolled back.');
}

function cmd_migrate_refresh() {
    cmd_migrate_reset();
    writeln();
    cmd_migrate();
}

