function cmd_db_seed($options = []) {
    $dir = AURA_SITE . '/seeders';
    if (!is_dir($dir)) {
        error('No seeders directory found. Create one with: php aura make:seeder <name>');
        return 1;
    }

    require_once AURA_SYSTEM . '/core/base.php';
    require_once AURA_SYSTEM . '/core/database.php';
    require_once AURA_SYSTEM . '/core/query-builder.php';
    require_once AURA_SYSTEM . '/core/seeder.php';

    $files = glob("{$dir}/*.php");
    sort($files);

    if (empty($files)) {
        warn('No seeders found.');
        return;
    }

    // Filter by --class option
    if (isset($options['class'])) {
        $target = kebabCase($options['class']);
        $files = array_filter($files, function ($f) use ($target) {
            return str_contains(basename($f), $target);
        });
        $files = array_values($files);

        if (empty($files)) {
            error("No seeder found matching: {$options['class']}");
            return 1;
        }
    }

    $db = new AuraCore\Database();
    $seeded = 0;

    foreach ($files as $file) {
        $filename = basename($file);
        require_once $file;

        $base = preg_replace('/_seeder\.php$/', '', $filename);
        $base = preg_replace('/\.php$/', '', $base);
        $className = studlyCase($base) . 'Seeder';
        $className = str_replace('-', '_', $className);

        if (!class_exists($className)) {
            warn("Could not find class for seeder: {$filename}");
            continue;
        }

        write("  {$filename} ... ", 'gray');
        try {
            $seeder = new $className();
            $seeder->setDb($db);
            $seeder->run();
            done();
            $seeded++;
        } catch (\Exception $e) {
            error('  FAILED');
            error("  {$e->getMessage()}");
            return 1;
        }
    }

    writeln();
    success("Seeded: {$seeded} seeder(s)");
}

