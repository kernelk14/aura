function cmd_migrate() {
    $dir = AURA_SITE . '/migrations';
    if (!is_dir($dir)) {
        error('No migrations directory found. Create one with: php aura make:migration <name>');
        return 1;
    }

    $db = db_bootstrap();
    $pdo = $db->getPdo();
    $driver = $db->getDriver();

    ensure_migrations_table($pdo, $driver);

    $currentBatch = fetch_max_batch($pdo);
    $newBatch = $currentBatch + 1;

    $stmt = $pdo->query("SELECT migration FROM migrations");
    $ran = $stmt->fetchAll(\PDO::FETCH_COLUMN);

    $files = glob("{$dir}/*.php");
    sort($files);

    $pending = [];
    foreach ($files as $file) {
        $filename = basename($file);
        if (!in_array($filename, $ran)) {
            $pending[] = $file;
        }
    }

    if (empty($pending)) {
        info('Nothing to migrate.');
        return;
    }

    $migrated = 0;
    foreach ($pending as $file) {
        $filename = basename($file);
        require_once $file;

        $class = migration_class($filename);
        if (!class_exists($class)) {
            warn("Could not find class for migration: {$filename}");
            continue;
        }

        write("  {$filename} ... ", 'gray');
        $inTransaction = false;
        try {
            if (!$pdo->inTransaction()) {
                $pdo->beginTransaction();
                $inTransaction = true;
            }

            $migration = new $class();
            if (method_exists($migration, 'setDb')) {
                $migration->setDb($db);
            }
            $migration->up();

            $stmt = $pdo->prepare("INSERT INTO migrations (migration, batch) VALUES (?, ?)");
            $stmt->execute([$filename, $newBatch]);

            if ($inTransaction) {
                $pdo->commit();
            }

            done();
            $migrated++;
        } catch (\Exception $e) {
            if ($inTransaction && $pdo->inTransaction()) {
                $pdo->rollBack();
            }
            error('  FAILED');
            error("  {$e->getMessage()}");
            return 1;
        }
    }

    writeln();
    success("Migrated: {$migrated} migration(s)");
}

function cmd_migrate_rollback() {
    $dir = AURA_SITE . '/migrations';
    if (!is_dir($dir)) {
        error('No migrations directory found.');
        return 1;
    }

    $db = db_bootstrap();
    $pdo = $db->getPdo();
    $driver = $db->getDriver();

    try {
        $pdo->query("SELECT 1 FROM migrations LIMIT 1");
    } catch (\Exception $e) {
        warn('No migrations table found. Nothing to rollback.');
        return;
    }

    $lastBatch = fetch_max_batch($pdo);

    if ($lastBatch === 0) {
        info('Nothing to rollback.');
        return;
    }

    $stmt = $pdo->prepare("SELECT migration FROM migrations WHERE batch = ? ORDER BY id DESC");
    $stmt->execute([$lastBatch]);
    $toRollback = $stmt->fetchAll(\PDO::FETCH_COLUMN);

    if (empty($toRollback)) {
        info('Nothing to rollback.');
        return;
    }

    $rolledBack = 0;
    foreach ($toRollback as $filename) {
        $file = "{$dir}/{$filename}";
        if (!file_exists($file)) {
            warn("Migration file not found: {$filename}");
            continue;
        }

        require_once $file;
        $class = migration_class($filename);

        if (!class_exists($class)) {
            warn("Could not find class for migration: {$filename}");
            continue;
        }

        write("  {$filename} ... ", 'gray');
        $inTransaction = false;
        try {
            if (!$pdo->inTransaction()) {
                $pdo->beginTransaction();
                $inTransaction = true;
            }

            $migration = new $class();
            if (method_exists($migration, 'setDb')) {
                $migration->setDb($db);
            }
            $migration->down();

            $stmt = $pdo->prepare("DELETE FROM migrations WHERE migration = ? AND batch = ?");
            $stmt->execute([$filename, $lastBatch]);

            if ($inTransaction) {
                $pdo->commit();
            }

            done();
            $rolledBack++;
        } catch (\Exception $e) {
            if ($inTransaction && $pdo->inTransaction()) {
                $pdo->rollBack();
            }
            error('  FAILED');
            error("  {$e->getMessage()}");
            return 1;
        }
    }

    writeln();
    success("Rolled back: {$rolledBack} migration(s)");
}

