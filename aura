    if (file_exists(AURA_SYSTEM . '/config/database.php')) {
        $dbConfig = require AURA_SYSTEM . '/config/database.php';
        $default = $dbConfig['default'] ?? [];
        $driver = $default['driver'] ?? 'unknown';
        $host = $default['host'] ?? 'unknown';
        $dbName = $default['database'] ?? 'unknown';
        write('  DB Driver:          ', 'gray');
        writeln($driver, 'green');
        write('  DB Host:            ', 'gray');
        writeln($host, 'cyan');
        write('  DB Name:            ', 'gray');
        writeln($dbName, 'cyan');
        writeln();
    }

    // Count files
    $counts = [
        'Controllers' => count(glob(AURA_SITE . '/controllers/*.php')),
        'Models'       => count(glob(AURA_SITE . '/models/*.php')),
        'Migrations'   => count(glob(AURA_SITE . '/migrations/*.php')),
        'Seeders'      => count(glob(AURA_SITE . '/seeders/*.php')),
        'Middleware'   => count(glob(AURA_SITE . '/middleware/*.php')),
        'Views'        => count(glob(AURA_SITE . '/views/*.php')),
    ];

    write('  Application Stats', 'bold');
    writeln();
    foreach ($counts as $label => $count) {
        write(str_pad("    {$label}:", 20), 'gray');
        writeln($count > 0 ? (string)$count : '0', $count > 0 ? 'green' : 'gray');
    }
    writeln();
}

