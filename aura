function cmd_list($commands, $categories, $version) {
    writeln();
    write(" AuraPHP CLI ", 'cyan');
    writeln(" v{$version}", 'gray');
    writeln(str_repeat('─', 54), 'gray');
    writeln();

    $grouped = [];
    foreach ($commands as $cmd => $meta) {
        $cat = $meta['category'] ?? 'util';
        $grouped[$cat][] = ['name' => $cmd, 'desc' => $meta['description']];
    }

    foreach ($categories as $key => $label) {
        if (empty($grouped[$key])) continue;
        write(" {$label}", 'bold');
        writeln();
        $maxLen = max(array_map(function($c) { return strlen($c['name']); }, $grouped[$key]));
        foreach ($grouped[$key] as $cmd) {
            write('  ');
            write(str_pad($cmd['name'], $maxLen + 2), 'green');
            write($cmd['desc'], 'gray');
            writeln();
        }
        writeln();
    }

    writeln(' Run "php aura <command> --help" for more information.', 'gray');
    writeln();
}

function cmd_help($commands, $categories, $cmd) {
    if (!isset($commands[$cmd])) {
        error("Unknown command: {$cmd}");
        return;
    }
    $meta = $commands[$cmd];
    $cat = $categories[$meta['category']] ?? $meta['category'];
    writeln();
    write(" {$cmd}", 'green');
    writeln("  -  {$meta['description']}", 'gray');
    writeln(str_repeat('─', 54), 'gray');
    writeln();
    write('  Category: ', 'gray');
    writeln($cat);
    write('  Usage:   ', 'gray');
    writeln("php aura {$meta['usage']}");
    writeln();
}

function cmd_serve($options) {
    $host = $options['host'] ?? '127.0.0.1';
    $port = $options['port'] ?? '8080';
    $docRoot = AURA_ROOT;

    if (isset($options['help'])) {
        info('Usage: php aura serve [--host=127.0.0.1] [--port=8080]');
        return;
    }

    writeln();
    info(' AuraPHP development server starting...');
    writeln();
    write('   Host: ', 'gray');
    writeln($host, 'cyan');
    write('   Port: ', 'gray');
    writeln($port, 'cyan');
    write('   Root: ', 'gray');
    writeln($docRoot, 'cyan');
    writeln();
    writeln(' Press Ctrl+C to stop the server.', 'gray');
    writeln();

    $cmd = sprintf(
        'php -S %s:%d -t %s',
        escapeshellarg($host),
        (int)$port,
        escapeshellarg($docRoot)
    );
    passthru($cmd);
}

